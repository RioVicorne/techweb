{
  "name": "dh25dtd-web1",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20 <24"
  },
  "scripts": {
    "dev": "node ./node_modules/next/dist/bin/next dev --turbopack",
    "build": "rm -rf .next && node ./node_modules/next/dist/bin/next build",
    "start": "node ./node_modules/next/dist/bin/next start",
    "lint": "eslint",
    "test": "vitest run",
    "db:start": "npx supabase start",
    "db:stop": "npx supabase stop",
    "db:reset": "npx supabase db reset",
    "db:link": "npx supabase link --project-ref gekzzymflsatrofgockg",
    "db:status": "npx supabase link status --project-ref gekzzymflsatrofgockg",
    "db:push": "npx supabase db push",
    "db:push:prod": "sh -c 'if [ -z \"$SUPABASE_DB_PASSWORD\" ]; then echo \"Missing SUPABASE_DB_PASSWORD\"; exit 1; fi; npx supabase db push'",
    "db:push:prod:dry": "sh -c 'if [ -z \"$SUPABASE_DB_PASSWORD\" ]; then echo \"Missing SUPABASE_DB_PASSWORD\"; exit 1; fi; npx supabase db push --dry-run'",
    "db:pull": "npx supabase db pull",
    "db:migration:list": "npx supabase migration list",
    "db:migration:new": "npx supabase migration new"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.49.1",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.37.0",
    "next": "^15.2.0",
    "pc-vn": "^1.0.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "stripe": "^14.25.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^15.2.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.4"
  }
}
